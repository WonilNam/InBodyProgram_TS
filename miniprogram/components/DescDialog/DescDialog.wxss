/* components/DescDialog/DescDialog.wxss */
.mask, .bg_gray{
    position:fixed;
    top:0;
    left:0;
    right:0;
    bottom:0;
    background-color:rgba(0,0,0,0.4);
    display:flex;
    align-items: center;
    justify-content:center;
    z-index: 999;
  }
  .dialog{
    width:calc(100% - 100rpx);
    max-width: 650rpx;
    height:auto;
    max-height: 85vh;
    margin: 50rpx;
    background:#fff;
    border-radius:30rpx;
    z-index: 1000;
    display: flex;
    flex-direction: column;
    overflow: hidden;
    box-sizing: border-box;
  }
  .dialog-header{
      display: flex;
      flex-direction: row;
      justify-content: space-between;
      align-items: center;
    text-align:center;
    font-size:36rpx;
    border-bottom: 1px solid #eee;
  }

  .dialog-header .title {
      margin: 40rpx;
    font-weight: 700;
    font-size: 15px;
  }

  .dialog-footer{
    display:flex;
  }
  .dialog-btn{
    flex:1;
    text-align:center;
    padding:40rpx 0;
    border-top:1rpx solid #eee;
  }
  .dialog-btn:first-child{
    border-right:1rpx solid #eee;
  }
  .dialog-body{
      display: flex;
      flex-direction: column;
    padding: 40rpx 40rpx 80rpx 40rpx;
    box-sizing: border-box;
    max-height: 70vh;
  }
  .dialog-body .content {
    width: 100%;
    color: #777;
    font-size: 13px;
    line-height: 48rpx;
    padding-bottom: 24rpx;
    box-sizing: border-box;
    white-space: pre-wrap;
    word-break: break-all;
  }

  .native-dialog-body {
    display: block;
    min-height: 180rpx;
  }

  .imgCancel{
      width: 50rpx;
      height: 50rpx;
      padding: 40rpx;
  }
