.measureMask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background-color: rgba(17, 24, 39, 0.72);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 1200;
}

.measureCard {
  width: 620rpx;
  padding: 56rpx 44rpx 48rpx;
  background: #ffffff;
  border-radius: 36rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  box-sizing: border-box;
}

.deviceBadge {
  font-size: 24rpx;
  font-weight: 600;
  color: #b50937;
  background: rgba(181, 9, 55, 0.08);
  padding: 8rpx 24rpx;
  border-radius: 999rpx;
  margin-bottom: 24rpx;
}

.stateTitle {
  font-size: 32rpx;
  font-weight: 600;
  color: #111827;
  text-align: center;
  margin-bottom: 36rpx;
}

.weightBox {
  display: flex;
  align-items: baseline;
  justify-content: center;
  margin-bottom: 36rpx;
}

.weightValue {
  font-size: 72rpx;
  font-weight: 700;
  color: #111827;
}

.weightUnit {
  font-size: 28rpx;
  color: #6b7280;
  margin-left: 8rpx;
}

.progressTrack {
  width: 100%;
  height: 16rpx;
  background: #e5e7eb;
  border-radius: 8rpx;
  overflow: hidden;
  margin-bottom: 32rpx;
}

.progressFill {
  height: 100%;
  background: #b50937;
  transition: width 0.2s ease;
}

.errorBanner {
  width: 100%;
  font-size: 26rpx;
  color: #dc2626;
  background: #fef2f2;
  padding: 18rpx 24rpx;
  border-radius: 16rpx;
  text-align: center;
  margin-bottom: 28rpx;
  box-sizing: border-box;
}

.cancelBtn {
  width: 100%;
  height: 84rpx;
  line-height: 84rpx;
  text-align: center;
  border-radius: 42rpx;
  background: #f3f4f6;
  color: #374151;
  font-size: 28rpx;
  font-weight: 600;
}
