.wrap{width:100%;box-sizing: border-box;display: flex;flex-direction: column;align-items: center;background-color: rgb(247, 248, 250);padding-top: 100rpx;position: relative;}
.mask {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background-color: rgba(0, 0, 0, 0.5); /* 半透明黑色 */
    z-index: 999; /* 确保蒙层在最上层 */
    pointer-events: none;
  }
.header{width:90%;font-size:5vw;color: rgb(64, 75, 95);font-weight:bold;display: flex;flex-direction: column;justify-content: center;align-items: center;box-sizing: border-box;}
.header .eqpName{height:70rpx;text-align: center;margin-top: 15rpx;font-size:42rpx;color: rgb(60, 72, 86);line-height: 70rpx;letter-spacing: 2rpx;}
.header .eqpVersion{height:50rpx;text-align: center;font-size:22rpx;color: rgb(131, 131, 131);line-height: 50rpx;}
.header .btnSet{width: 160rpx;background-color:rgb(204,13,54);color:white;font-size:22rpx;border-radius: 15rpx;height: 68rpx;display: inline-block;margin-top: 10rpx;text-align: center;line-height: 68rpx;letter-spacing: 2rpx;}
.header .title {width:40vw;height:40vw;border-radius: 50%;border: solid 1rpx rgb(240, 240, 240);background-color: white;display: flex;align-items: center;justify-content: center;}
.header .title image{width:90%;height:90%;}

.itemArea {width:90%;display: flex;flex-direction: column;justify-content: center;margin-top: 20rpx;box-sizing: border-box;padding-bottom: 50rpx;}
.itemArea .txtSetting{font-size: 32rpx;color: black;font-weight: bold;}
.itemArea .cntUser{width:100%;height:230rpx;border-radius: 20rpx;border: solid 1rpx rgb(223, 223, 223);display: flex;background-color: white;margin-top: 20rpx;box-shadow: 1rpx 5rpx 1rpx rgb(214, 214, 216);flex-direction: column;align-items: center;justify-content: center;}

.itemArea .img .user{width:66%;height: 90%;}

.itemArea .cntUser .txt{width: 92%;display: flex;align-items: center;justify-content: space-between;color: rgb(70, 73, 88);height: 30%;}
.itemArea .cntUser .txt .next{width:40rpx;height: 40rpx;}
.itemArea .cntUser .img{width: 92%;display: flex;align-items: center;justify-content: space-between;height: 50%;}
.itemArea .cntUser .img .count{display: flex;}

.itemArea .settings{width:100%;height:100rpx;border-radius: 20rpx;border: solid 1rpx rgb(223, 223, 223);display: flex;align-items: center;background-color: white;margin-top: 15rpx;box-shadow: 1rpx 5rpx 1rpx rgb(214, 214, 216);font-size: 28rpx;box-sizing: border-box;justify-content: center;}
.itemArea .settings .box{width: 92%;display: flex;align-items: center;justify-content: space-between;}
.itemArea .settings .box .next{width:40rpx;height: 40rpx;}
.itemArea .settings .box .right{display: flex;align-items: center;justify-content: space-between;width: 32%;color: rgb(131, 131, 131);}
.itemArea .settings .box  .ssid{display: flex;align-items: center;justify-content: flex-end;width: 70%;color: rgb(131, 131, 131);} 
switch{zoom: .8;}