.wrap{width:100%;height: 100vh;box-sizing: border-box;padding-top: 5vh;display: flex;flex-direction: column;align-items: center;background-color: rgb(247, 248, 250);border-top: solid 1rpx rgb(223, 223, 223);}

.header{width:90%;height:10vh;}
.header .ssid{width:550rpx;height:4.5vh;line-height: 92rpx;font-size: 4vw;color: rgb(64, 75, 95);font-weight:bold;overflow: hidden;}
.header .title{width:550rpx;height:4.5vh;line-height: 92rpx;font-size: 5.5vw;color: rgb(64, 75, 95);}
.inputArea{width:92%;height:9vh;border-radius: 20rpx;border:solid 1rpx gray;margin-top: 4vh;display: flex;align-items: center;background-color: #fff;}
input{flex: 1;height:9vh;font-size:4vw;letter-spacing: 0.5vw;margin-left: 5vw;}
.eyeIcon{width: 48rpx;height: 48rpx;margin-right: 30rpx;background-size: contain;background-repeat: no-repeat;background-position: center;}

/* 睁眼 SVG */
.eyeIcon.open {
    background-image: url("data:image/svg+xml;base64,");
}
/* 闭眼 SVG */
.eyeIcon.close {
    background-image: url("data:image/svg+xml;base64,");
}


