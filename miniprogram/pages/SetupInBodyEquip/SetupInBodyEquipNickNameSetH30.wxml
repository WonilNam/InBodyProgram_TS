<view class="wrap">
  <view class="header">
    <text class="title">{{title}}</text>
  </view>
 
  <view class="itemArea"> 
    <view class="imageArea">
        <image src="{{imgSrc}}"></image>        
    </view>
    <view class="txt">{{nickName}}</view>
    <view class="textArea">
      <view class="top" >设备屏幕</view>
      <view class="bottom" >将显示如下</view>
    </view>
    <view class="inputBody">
    <view class="inputArea" style="{{viewType == 'normal'?'border:solid 1rpx gray':'border:solid 1rpx red;'}}">
      <input  type="text" placeholder="6个字符以内的字母或数字" value="{{nickName}}" bindinput="inputChange" maxlength="6"/>   
    </view>  
    <view class="tilt" wx:if="{{viewType == 'error'}}">请输入6个字符以内的字母或数字</view>
    </view>
  </view>
