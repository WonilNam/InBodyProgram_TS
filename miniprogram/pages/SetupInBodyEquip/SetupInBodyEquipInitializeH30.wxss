.wrap{width:100%;height: 100vh;box-sizing: border-box;padding-top: 5vh;display: flex;flex-direction: column;align-items: center;background-color: white;border-top: solid 1rpx rgb(223, 223, 223);}

.header{width:90%;height:12vh;}
.header image{width:22%;height: 100%;margin-left: 35rpx;}
.itemArea{width:90%;height:75vh;display: flex;flex-direction: column;align-items: center;box-sizing: border-box;}
.itemArea .title{width:90%;height:4vh;line-height: 4vh;font-size: 33rpx;color: rgb(64, 75, 95);margin-top: 5rpx;font-weight: bold;}
.itemArea .text{width:90%;font-size: 28rpx;color: rgb(64, 75, 95);letter-spacing: 5rpx;margin-top: 20rpx;line-height: 37rpx;}
.itemArea .inputArea{width:92%;border-radius: 20rpx;border:solid 1rpx gray;margin-top: 2vh;}
.itemArea input{width:90%;height:9vh;font-size:4vw;letter-spacing: 0.5vw;margin-left: 5vw;line-height: 8vh;}
.foot{width: 100%;height: 13vh;box-sizing: border-box;display: flex;align-items: center;}
.btnSet{width: 90%;background-color:rgb(212,33,75);color:white !important;font-size:40rpx;border-radius: 15rpx;font-size: 5vw;}

