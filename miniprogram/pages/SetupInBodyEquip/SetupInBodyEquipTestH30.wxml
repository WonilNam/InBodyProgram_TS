<view class="wrap">
    <view class="header">
        <view class="text">{{viewType == 'measure'?'正在分析用户':'开始'}}</view>
        <view class="text">{{viewType == 'measure'?'体成分。':'InBody测试'}}</view>
    </view>

    <body class="itemArea">

        <view class='progress_box'>
            <canvas class="progress_bg" type="2d" id="canvasProgressbg2d"></canvas>
            <canvas class="progress_canvas" type="2d" id="canvasProgress2d"></canvas>
        </view>

    </body>

    <view class="foot">
        <view class="circle" wx:if="{{viewType != 'measure'}}">
            <view class="cir" style="{{viewType == 'weight'?'background-color: white;':'background-color: #969b9e;'}}">1</view>
            <view class="cir" style="{{viewType == 'posture'?'background-color: white;':'background-color: #969b9e;'}}">2</view>
        </view>

        <view class="text">{{tiltText}}
            <p style="color: #23bb95;" wx:if="{{viewType == 'posture'}}">手柄</p>
        </view>
        <view class="text" wx:if="{{viewType == 'weight'}}">测量<p style="color: #23bb95;">体重</p>
        </view>
    </view>

</view>