<view class="wrap" >
  <view class="header">
    <view class="ssid">{{SSID}}</view>
    <view class="title">请输入密码（最多{{maxPasswordLength}}位）。</view>
  </view>
    <view class="inputArea">
        <input password="{{!showPassword}}" value="{{passwordValue}}" bindinput="onInput" bindconfirm="onConfirm" maxlength="{{maxPasswordLength}}"/>
        <view class="eyeIcon {{showPassword ? 'open' : 'close'}}" bindtap="toggleShowPassword"></view>
    </view>
  
</view>