page { background: #f3f5f7; color: #202735; font-family: "PingFang SC", "Microsoft YaHei", sans-serif; }
.share-page { min-height: 100vh; box-sizing: border-box; }
button { margin: 0; }
button::after { border: 0; }
.generating, .generate-failed { display: flex; flex-direction: column; align-items: center; justify-content: center; box-sizing: border-box; min-height: 82vh; padding: 48rpx; color: #7b8490; }
.generating-card { position: relative; width: 356rpx; height: 472rpx; padding: 22rpx; border-radius: 26rpx; background: #fff; box-shadow: 0 22rpx 60rpx rgba(45,54,67,.13); transform: rotate(-2deg); }
.report-skeleton { height: 100%; padding: 24rpx 20rpx; box-sizing: border-box; border: 1rpx solid #eef0f2; }
.skeleton-brand { width: 116rpx; height: 30rpx; border-radius: 8rpx; background: #45506b; }
.skeleton-line { width: 45%; height: 12rpx; margin-top: 20rpx; border-radius: 8rpx; background: #dfe3e7; }
.skeleton-line-long { width: 76%; }
.skeleton-section { height: 28rpx; margin: 34rpx -20rpx 0; background: #f3f5f7; }
.skeleton-row { height: 44rpx; margin-top: 22rpx; border-bottom: 2rpx solid #edf0f2; }
.loading-ring { position: absolute; right: -22rpx; bottom: -22rpx; width: 62rpx; height: 62rpx; border: 7rpx solid #e1e5e8; border-top-color: #47b998; border-radius: 50%; background: #fff; box-shadow: 0 8rpx 22rpx rgba(45,54,67,.14); animation: spin .8s linear infinite; }
.generating-title { margin-top: 56rpx; color: #454a5b; font-size: 32rpx; font-weight: 600; }
.generating-note { margin-top: 12rpx; font-size: 24rpx; }
.generate-failed { gap: 28rpx; font-size: 28rpx; }
.generate-failed button { padding: 0 36rpx; border-radius: 16rpx; background: #45506b; color: #fff; }
@keyframes spin { to { transform: rotate(360deg); } }
.share-result { display: flex; flex-direction: column; box-sizing: border-box; height: calc(100vh - 150rpx - env(safe-area-inset-bottom)); padding: 24rpx 24rpx 18rpx; }
.preview-shell { display: flex; flex: 1; flex-direction: column; min-height: 0; border: 1rpx solid #e3e7ea; border-radius: 24rpx; background: #fff; box-shadow: 0 10rpx 32rpx rgba(45,54,67,.09); overflow: hidden; }
.paper-preview { flex: 1; min-height: 0; width: 100%; background: #fff; }
.result-image { display: block; width: 100%; height: auto; }
.preview-tip { display: flex; flex-shrink: 0; align-items: center; justify-content: center; height: 76rpx; border-top: 1rpx solid #edf0f2; background: #fff; color: #6f7884; font-size: 24rpx; }
.preview-arrow { margin-left: 10rpx; color: #45506b; font-size: 36rpx; line-height: 1; }
.action-bar { position: fixed; right: 0; bottom: 0; left: 0; z-index: 20; display: grid; grid-template-columns: 1fr 1.35fr; gap: 20rpx; padding: 22rpx 32rpx calc(22rpx + env(safe-area-inset-bottom)); border-top: 1rpx solid rgba(69,74,91,.07); background: rgba(255,255,255,.96); box-shadow: 0 -12rpx 36rpx rgba(45,54,67,.08); }
.action-button { display: flex; align-items: center; justify-content: center; box-sizing: border-box; height: 88rpx; padding: 0 24rpx; border-radius: 20rpx; font-size: 28rpx; font-weight: 600; line-height: 88rpx; }
.action-button image { width: 34rpx; height: 34rpx; margin-right: 14rpx; }
.secondary-action { border: 2rpx solid #d9dee3; background: #fff; color: #45506b; }
.primary-action { border: 2rpx solid #45506b; background: #45506b; color: #fff; box-shadow: 0 10rpx 24rpx rgba(69,80,107,.20); }
.action-button[disabled] { opacity: .55; }
.export-canvas { position: fixed; left: -2000px; top: 0; pointer-events: none; }

@media (max-height: 700px) {
  .share-result { padding-top: 16rpx; }
}
