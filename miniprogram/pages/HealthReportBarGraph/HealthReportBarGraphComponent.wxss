    margin-right: 50rpx;
    background-color: #FCD655;
    color: white;
    padding: 6rpx 32rpx 6rpx 32rpx;
    border-radius: 30rpx;
}

.interpretation {
    clear: both;
    font-size: 13px;
    padding: 15rpx;
    margin: 20rpx;
    background-color: #fff;
    border-radius: 10rpx;
}

.btnAddMenu {
    display: flex !important;
    align-items: center;
    text-align: left;
    border: none !important;
    font-size: 28rpx;
    height: 96rpx;
    line-height: 96rpx;
    padding: 0 30rpx !important;
    box-sizing: border-box;
    width: 100%;
}

.btnAddMenuText {
    display: flex;
    padding-top: 14rpx;
    color: #798088;
}

.header {
    height: 110rpx;
    width: 100%;
    z-index: 50;
}

.header { display: flex; align-items: center; gap: 18rpx; box-sizing: border-box; height: 114rpx; padding: 20rpx 30rpx; background: #f7f8fa; }
.selectdate { box-sizing: border-box; display: flex; align-items: center; height: 74rpx; overflow: hidden; border-radius: 40rpx; background: #fff; box-shadow: 0 3rpx 9rpx rgba(32,39,48,.12); }
.date-step { display: flex; align-items: center; justify-content: center; flex: 0 0 74rpx; height: 74rpx; margin: 0; padding: 0; border: 0; }
.date-step-icon { width: 30rpx; height: 30rpx; }
.date-label { flex: 1; min-width: 0; margin: 0; padding: 0; border: 0; color: #454a5b; font-size: 28rpx; font-weight: 400; line-height: 74rpx; }
.date-step::after, .date-label::after { border: 0; }
.selectdate .date-step, .selectdate .date-label { height: 74rpx; border: 0; border-radius: 0; background: transparent; box-shadow: none; }
.selectdate .date-step { opacity: 1; }
.selectdate .date-step-icon { opacity: .65; }
.header .selectdate { flex: 1; min-width: 0; width: auto; }
.date-delete { display: flex; flex: 0 0 86rpx; align-items: center; justify-content: center; height: 74rpx; margin: 0; padding: 0; border: 0; border-radius: 40rpx; background: #fff; box-shadow: 0 3rpx 9rpx rgba(32,39,48,.12); }
.date-delete::after { border: 0; }
.date-delete-icon { width: 44rpx; height: 44rpx; }
.segment-heading {
    display: flex;
    align-items: center;
    justify-content: space-between;
    box-sizing: border-box;
    padding: 0 24rpx 0 30rpx;
    line-height: normal;
}

.footerButtons {
    height: 100%;
    width: 100%;
    bottom: 0rpx;
    z-index: 10;
    vertical-align: middle;
}

.footerButtons .btnAddMenu {
    margin: 0 0 5rpx 0;
    border-radius: 10rpx;
}

.detail-compo {
    margin-top: 20rpx;
    padding-bottom: 10rpx;
    background-color: #fff;
}

.cid-explanation {
    padding: 16rpx 24rpx 20rpx;
    color: #66717c;
    font-size: 24rpx;
    line-height: 1.6;
}

.segmentview {
    display: flex;
    align-items: center;
    background-color: #E9ECF0;
    box-shadow: 10px 10px 15px -15px #333;
    border-radius: 15rpx;
}

.segmentview .segmentItem {
    flex:1;
    align-self: center;
    text-align: center;
    height: 60rpx;
    line-height: 50rpx;
    margin: 10rpx;
    border-radius: 18rpx;
    color: #798088;
}

.segmentview .segmentItem.active {
    background-color:#fff;
    font-weight: bold;
}

.segmentGraph {
    display: flex;
    flex-direction: row;
    align-items: center;
    margin-top: 20rpx;
}

.chart {
    flex:2;
    align-self:center;
    overflow: hidden;
}

.analysis {
    flex:1;
}
.analysis .part {
    padding: 5px;
    background-color: #fff;
    border-radius: 15rpx;
    box-shadow: -5px -5px 20px -20px #333;
    margin-bottom: 10rpx;
}
.analysis .firstLine {
    font-size: 9px;
    color: #798088;
}
.analysis .secondLine {
    display:flex;
    flex-direction: row;
    justify-content: space-between;
}

.analysis .secondLine .weight{
    display:flex;
    flex-direction: row;
    align-items: center;
}

.analysis .secondLine .weight .param{
    font-weight: 300;
    font-size: 10px;
    margin-left: 5rpx;
}

.analysis .secondLine .weight .no {
    color: #454A5B;
    font-weight: 600;
}

.analysis .secondLine .change {
    background-color: #eee;
    border-radius: 10rpx;
    padding: 2px 6px 0;
    font-weight: 500;
    font-size: 8px;
    height: 30rpx;
    align-self: center;
}

.bodyCoordinator {
    display: flex;
    justify-content: center;
    width: 100%;
    background-color: #fff;
}

.bodyCoordinator .wrapper {
    width: 100%;
    display: block;
}

.bodyBalance {
    padding: 5px 7px;
    border-radius: 5px;
    font-weight: 700;
    font-size: 30rpx;
}

.bodyBalance.green {
    color: #454A5B;
    background-color: #caede2;
}

.bodyBalance.orange {
    color: #454A5B;
    background-color: #fbe9d3;
}

.bodyBalance.red {
    color: #454A5B;
    background-color: #ffd4dd;
}

.inbody-score, .inbody-age {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin: 30rpx;
    padding: 40rpx 50rpx;
    background-color: #fff;
    border-radius: 35rpx;
}

.change-score, .change-age {
    display: flex;
    justify-content: center;
    align-items: center;
}

.change-score .title, .change-age .title {
    color: #798088;
    font-weight: 600;
    font-size: 13px;
}

.change-score .change, .change-age .change {
    display: inline-block;
    font-weight: 400;
    font-size: 9px;
    padding: 3rpx 20rpx;
    margin-left: 20rpx;
    border-radius: 10rpx;
    color: #798088;
    background-color: #eee;
    vertical-align:middle;
    margin-top: 2px;
}

.inbody-score .score, .inbody-age .age{
    font-size: 20px;
    font-weight: 600;
    color: #454A5B;
}

.scoreUnit{
    font-size: 13px;
    font-weight: 600;
    color: #798088;
}

.inbody-score, .inbody-age { box-sizing: border-box; min-height: 132rpx; margin: 20rpx 30rpx; padding: 26rpx 38rpx; border-radius: 32rpx; box-shadow: 0 3rpx 9rpx rgba(32,39,48,.10); }
.change-score .title, .change-age .title { color: #454a5b; font-size: 30rpx; font-weight: 600; white-space: nowrap; }
.change-score .change, .change-age .change { margin-left: 20rpx; padding: 5rpx 14rpx; border-radius: 10rpx; background: #f2f2f5; color: #87909a; font-size: 25rpx; line-height: 32rpx; }
.inbody-age .age, .inbody-score .score { display: flex; align-items: baseline; white-space: nowrap; color: #454a5b; }
.summary-primary { font-size: 58rpx; font-weight: 700; line-height: 1.15; }
.summary-unit { margin-left: 4rpx; font-size: 28rpx; font-weight: 600; color: #798088; }
.summary-age-reference { font-size: 29rpx; font-weight: 600; color: #798088; }
.radar .img {
    position: absolute; 
    top: 50%;
    left: 50%;
    width: 120rpx;
    transform: translate(-50%,-55%);
}

.radarImage{
    width: 100%;
    height: 100%;
}

.radar .radarCanvas {
    width: 500rpx; height: 500rpx; z-index: 25; 
}
.segment-section .inbodydataview { padding: 12rpx 30rpx 36rpx; border-top: 0; }
.segment-section .segmentview { padding: 6rpx; border-radius: 18rpx; box-shadow: none; }
.segment-section .segmentItem { display: flex; align-items: center; justify-content: center; height: 64rpx; margin: 0; border-radius: 14rpx; line-height: 1.3; }
.segment-tab-label { font-size: 25rpx; }
.segment-section .segmentItem.active { color: #424c5e; }
.segment-section .segmentGraph { align-items: center; margin-top: 30rpx; }
.segment-section .chart { flex: 0 0 57%; min-width: 0; }
.segment-section .analysis { flex: 1; min-width: 0; }
.segment-section .radar { position: relative; }
.segment-section .radarCanvas { width: 398rpx; height: 500rpx; }
.segment-section .radar .img { width: 108rpx; transform: translate(-50%,-50%); }
.segment-section .analysis .part { box-sizing: border-box; min-height: 104rpx; padding: 12rpx 14rpx; margin-bottom: 9rpx; border: 2rpx solid #ececee; border-radius: 17rpx; box-shadow: 0 1rpx 3rpx rgba(32,39,48,.04); }
.segment-section .analysis .firstLine { color: #818a94; font-size: 23rpx; font-weight: 600; line-height: 30rpx; }
.segment-section .analysis .secondLine { align-items: baseline; margin-top: 5rpx; gap: 4rpx; }
.segment-section .analysis .secondLine .weight { align-items: baseline; }
.segment-section .analysis .secondLine .weight .no { font-size: 34rpx; line-height: 42rpx; }
.segment-section .analysis .secondLine .weight .param { margin-left: 3rpx; font-size: 22rpx; color: #89919a; }
.segment-section .analysis .secondLine .change { flex-shrink: 0; height: auto; padding: 4rpx 8rpx; border-radius: 9rpx; background: #f2f2f5; color: #7c8694; font-size: 22rpx; font-weight: 600; line-height: 28rpx; }

.dataChange {
    background-color: #eee;
    border-radius: 10rpx;
    padding: 2px 6px;
    font-weight: 500;
    font-size: 10px;
}

.change-wrapper {
    display: block; width: 100%; margin-top: 25px; 
}

.change-wrapper .dataChange {
    margin-left: -140rpx;color:#798088; font-weight: 700;
}

.inBodyAgeCanvas {
    width: 100%;
    height: 160px;
}

.ageContent {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
}

.age-question{
    width: 100%;
}

.age-question .question-wrapper{
    color: #798088;
    font-size: 12px;
    border-radius: 8px;
    padding: 10px;
    margin:10px 0;
    background-color: #dddddd33;
}

.age-question .questionStyle {
    display: flex; justify-content: space-between; align-items: center;
  cursor: pointer;
}

.age-question .answerStyle {
  color: #798088;
  margin-top: 10px;
  display: none;
  transition: all 0.3s ease;
  word-wrap: break-word;
  white-space: normal;
  overflow-wrap: break-word;
}

.cid .bg-img {
    position: absolute;
    top: 30rpx;
    left: calc(25% + 100rpx);
    height: 180rpx;
}
.result-loading {
  min-height: 100vh;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-direction: column;
  gap: 20rpx;
  color: #818995;
  background: #f4f5f7;
  font-size: 28rpx;
}

.result-loading-spinner {
  width: 48rpx;
  height: 48rpx;
  border: 5rpx solid #d8dce3;
  border-top-color: #3d4b68;
  border-radius: 50%;
  animation: result-loading-spin 0.8s linear infinite;
}

@keyframes result-loading-spin {
  to { transform: rotate(360deg); }
}
