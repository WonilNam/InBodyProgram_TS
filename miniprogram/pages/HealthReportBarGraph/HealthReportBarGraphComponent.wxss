}

.inbodydataview {
    color: #798088;
    background-color: #fff;
    padding: 10px;
    border-radius: 20rpx;
    border-top: 1px solid #eee;
}

.clearfloat::after {
    display: block;
    clear: both;
    content: "";
    visibility: hidden;
    height: 0
}

.clearfloat {
    zoom: 1;
}

.data_title {
    color: #798088;
