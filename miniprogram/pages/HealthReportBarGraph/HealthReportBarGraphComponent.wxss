.leftdiv.balance{
    width: 100%;
    margin-top: 10px;
    height: 60rpx;
}

.leftdiv .fs24 {
    color: #454A5B;
}

.rightdiv {
    float: right;
    width: 75%;
    height: 60rpx;
}

.bargraph {
    clear: both;
    width: 500rpx;
    height: 150rpx;
    margin-top: -25rpx;
}

.graphdiv {
    padding-left: 5px;
}

.unit {
    margin-top: 50rpx;
    font-size: 13px;
    color: #798088;
}

.imgHelp {
    width: 48rpx;
    height: 48rpx;
    margin-right: 16rpx;
    flex-shrink: 0;
}

.txtHelp {
    font-size: 28rpx;
