<view wx:if="{{isLoading}}" class="result-loading"><view class="result-loading-spinner"></view><text>加载中…</text></view>
<view style='height:100%; background-color:#eee;' wx:elif="{{IsExistsData}}">
    <view class='header'>
        <view class='selectdate'>
            <button class="date-step" style="background-color: #fff;" disabled='{{InBodyData.IsNotPrev}}' bindtap="bindPrevInBodyData"><image class="date-step-icon" src="{{InBodyData.PreSrc}}" /></button>
            <button class="date-label" bindtap="bindInBodyDataSelect">{{InBodyData.DATETIMES_TXT}}</button>
            <button class="date-step" style="background-color: #fff;" disabled='{{InBodyData.IsNotNext}}' bindtap="bindNextInBodyData"><image class="date-step-icon" src="{{InBodyData.NextSrc}}" /></button>
        </view>
        <button class="date-delete" bindtap="confirmDeleteRecord"><image class="date-delete-icon" src="/images/report_delete.svg" /></button>
    </view>
    <view wx:if="{{InBodyData && InBodyData.InBodyAge && InBodyData.InBodyAge.VALUE && InBodyData.InBodyAge.VALUE != 0 && (!InBodyData.InBodyAge.Style || InBodyData.InBodyAge.Style.indexOf('none') < 0)}}" style="{{InBodyData.InBodyAge.Style}}" class="inbody-age" bind:tap="showDesc" data-tag="InBodyAge">
        <view class="change-age">
            <view class="title">InBody 年龄</view>
            <view class="change">{{ChangeRange.InBodyAge>0?"+"+ChangeRange.InBodyAge:ChangeRange.InBodyAge}}</view>
        </view>
        <view class="age"><text class="summary-primary">{{InBodyData.InBodyAge.VALUE}}</text><text class="summary-unit">岁</text><text class="summary-age-reference">/{{InBodyData.AGE}}岁</text></view>
    </view>
    <view wx:if="{{InBodyData.FS.VALUE && InBodyData.FS.VALUE != 0 && (!InBodyData.FS.Style || InBodyData.FS.Style.indexOf('none') < 0)}}" style="{{InBodyData.FS.Style}}" class="inbody-score" bind:tap="showDesc" data-tag="SCORE">
        <view class="change-score">
            <view class="title">InBody 分数</view>
            <view class="change">{{ChangeRange.SCORE>0?"+"+ChangeRange.SCORE:ChangeRange.SCORE}}</view>
        </view>
        <view class="score"><text class="summary-primary">{{InBodyData.FS.VALUE}}</text><text class="summary-unit">分</text></view>
    </view>
    <view style="background-color: white; z-index: 20;">
        <desc-dialog title="{{descTitle}}" status="{{descStatus}}" use-native-overlay="{{slotWrapper != 'age'}}" bind:cancel='handlecancel' content='{{descContent}}'>
            <view class="ageContent" wx:if="{{slotWrapper == 'age'}}">
                <view style="width: 100%; text-align: center;">
                    <canvas type="2d" id="bargraph_InBodyAge" class="inBodyAgeCanvas" style="width: 100%; height: 160px;"></canvas>
                </view>
                <view class="age-question">
                    <view class="question-wrapper" wx:for="{{questions}}" wx:key="id">
                        <view class="questionStyle" bindtap="toggleAnswer" data-index="{{index}}">
                            {{item.question}}
                            <image src="{{item.showAnswer ? '/images/icon_up.png' : '/images/expandMore.png'}}" style="width: 16px; height: 16px; margin-left: 10px;" />
                        </view>
                        <view style="{{item.showAnswer ? 'height: 1px; background:#ccc; margin: 10px 0;' : ''}}"></view>
                        <view class="answerStyle" style="{{item.showAnswer ? 'display: block;' : ''}}">
                            {{item.answer}}
                        </view>
                        <!-- <view wx:if="{{!index == questions.length - 1}}" style="height: 1px; background: #eee; margin: 15px 0;"></view> -->
                    </view>
                </view>
            </view>
        </desc-dialog>
    </view>
    <view class="detail-compo segment-section" wx:if="{{InBodyData && (!InBodyData.SEG_SLM.Style || !InBodyData.SEG_BFM.Style || !InBodyData.SEG_ECW_TBW.Style)}}">
        <view class='datagroup segment-heading'>
            <span class="vam fs17 bold titletxt">节段分析</span>
            <view class="detail-share-button" bindtap="openReportShare"><image class="detail-share-icon" src="../../images/share_report_blue.svg" mode="aspectFit" /></view>
        </view>
        <view class='inbodydataview'>
            <view class='segmentview'>
                <view style="{{InBodyData.SEG_SLM.Style}}" class='segmentItem {{segmentType=="smm"?"active":""}}' bindtap="changeSegmentType" data-type="smm">
                    <span class="segment-tab-label">肌肉量</span>
                </view>
                <view style="{{InBodyData.SEG_BFM.Style}}" class='segmentItem {{segmentType=="bfm"?"active":""}}' bindtap="changeSegmentType" data-type="bfm">
                    <span class="segment-tab-label">体脂肪</span>
                </view>
                <view style="{{InBodyData.SEG_ECW_TBW.Style}}" class='segmentItem {{segmentType=="wed"?"active":""}}' bindtap="changeSegmentType" data-type="wed">
                    <span class="segment-tab-label">细胞外水分比率</span>
                </view>
            </view>
            <view class="segmentGraph">
                <view class="chart">
                    <scroll-view scroll-y>
                        <view id="radarCanva" class="radar" style="width: 100%; height: 100%; text-align: center; ">
                            <view>
                                <canvas type="2d" id="bargraph_SEGMENT" class="radarCanvas" hidden="{{hideReportCanvases}}"></canvas>
                            </view>
                            <view class="img">
                                <image class="radarImage" src="/images/icon_body_gray.png" mode="widthFix"></image>
                            </view>
                        </view>
                    </scroll-view>
                </view>
                <view class="analysis">
                    <!-- segmentType=="smm"?InBodyData.SEG_SLM.DATA:segmentType=="bfm"?InBodyData.SEG_BFM.DATA:InBodyData.SEG_ECW_TBW.DATA -->
                    <view wx:for='{{AnalysisData}}' wx:key="TYPE">
                        <view class="part">
                            <view class="firstLine">{{item.NAME}}</view>
                            <view class="secondLine">
                                <view class="weight">
                                    <view class="no">{{item.VALUE}}</view>
                                    <view class="param">{{item.STYLE}}</view>
                                </view>
                                <view class="change">{{item.CHANGE>0?"+"+item.CHANGE:item.CHANGE}}</view>
                            </view>
                        </view>
                    </view>
                </view>
            </view>
        </view>
    </view>
