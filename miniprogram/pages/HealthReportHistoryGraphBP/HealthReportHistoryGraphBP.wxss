.container{
  height: 100%;
  width:100%;
}

.header{ height:80rpx; width:100%; z-index:50;background-color:white;}
.header .mainnoti {height:80rpx;width:750rpx;text-align:center;display:table;}
.header .mainnoti .mainlink {vertical-align:top;color:#60d0ca;font-size:24rpx;text-decoration:underline;font-weight: bold;/*display:table-cell;*/display:inline-block;padding-top:24rpx;}
.header .mainnoti .mainclose {width:48rpx;height:48rpx;padding:16rpx;/*display:table-cell;*/}


.body{height:100%;}

.graphArea{padding:8px;}
.resultsTap{background-color:white; width:100%;z-index: 20;border-top:solid 2rpx #f5f5f5;border-bottom:solid 2rpx #f5f5f5;}
.dataFilterArea{ background-color:white; width:100%; height:80rpx; z-index: 100; }
.filterText{font-size:28rpx;text-align:right;vertical-align:middle; display:inline-block;width:calc(100% - 90rpx);}
.filterText .text {display:inline-block;padding-top:2rpx;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;width:calc(100% - 90rpx );line-height:28rpx;vertical-align:middle;}
.icon{width:48rpx;height:48rpx;vertical-align:middle;padding:8px;}
.iconPadding{padding-top:24rpx;}

.btnR_TArea{height:80rpx; text-align: right;}
.btnR_T{height:52rpx; width:140rpx;display:inline-block; font-size:14px;font-weight: bold;padding-left:0rpx;padding-right:0rpx;line-height:52rpx;}
.btnR_TChecked{height:52rpx; width:140rpx;display:inline-block;background-color:#333; font-size:28rpx;color:white;font-weight: bold;padding-left:0rpx;padding-right:0rpx;line-height:52rpx;}

.historyArea{overflow-y:auto;}
.historyArea .historyArea-item#BP .graph{height:430rpx;}
.historyArea-item .title{font-size:32rpx;}
.historyArea-item .unit{font-size:24rpx;}
.historyArea-item .graph{
  width:100%;
  height:300rpx;
  z-index:1;
}
