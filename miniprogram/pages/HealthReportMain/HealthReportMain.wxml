  <view class="mainresultsTap">  
    <view class="maintapBtn {{ViewType=='InBodyDashboard'?'on':''}}">
      <button id="inbodyDashboard" plain="true" bindtap="moveTap">{{res.getString('Txt_InBodyDashboard', L)}}</button>  
    </view>
    <view class="maintapBtn {{ViewType=='InBodyResult'?'on':''}}">
      <button id="inbodyResult" plain="true" bindtap="moveTap">{{res.getString('Txt_InBodyResult', L)}}</button>  
    </view>
    <view class="maintapBtn {{ViewType=='HistoryGraph'?'on':''}}">
      <button id="historyGraph" plain="true" bindtap="moveTap">{{res.getString('Txt_HistoryGraph', L)}}</button>
    </view>
    <view class="maintapBtn {{ViewType=='InBodyMe'?'on':''}}">
      <button id="inbodyMe" plain="true" bindtap="moveTap">{{res.getString('Txt_InBodyMe', L)}}</button>  
    </view>
  </view>
