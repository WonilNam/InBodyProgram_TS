</view>

<view style="clear:both;"></view>
<view class="mainbody" style="Height:auto;{{isMainBody}}" >
  <main-compo class="mainbody" Refresh="{{Refresh}}" wx:if="{{ViewType == 'InBodyDashboard'&& NoData == ''}}" callbackView="InBodyDashboard"/>
  <view wx:if="{{hasOpenedResult && NoData == ''}}" hidden="{{ViewType != 'InBodyResult'}}">
    <bargraph-compo class="mainbody" Refresh="{{ResultRefresh}}" callbackView="InBodyResult"/>
  </view>
  <view wx:if="{{hasOpenedHistory && NoData == ''}}" hidden="{{ViewType != 'HistoryGraph'}}">
    <historygraph-compo class="mainbody" Refresh="{{HistoryRefresh}}" callbackView="HistoryGraph"/>
  </view>
  <me-compo class="mainbody" Refresh="{{Refresh}}" wx:if="{{ViewType == 'InBodyMe'&& NoData == ''}}" callbackView="InBodyMe"/>
  <nodata-compo Type="InBody" wx:if="{{NoData == 'NoData'}}"/>
</view>
<cover-view class="bottomTap" style="z-index: 50;" wx:if="{{false}}">
    <cover-view id="inbodyTest" class="maintapBtn {{navType=='InBodyTest'?'on':''}}" bindtap="moveNavTap">
        <cover-image style="width: 30px; height: 30px;" mode="aspectFill" src="{{reportSrc}}"></cover-image>
    </cover-view>
    <cover-view id="inbodyCommunity"  class="maintapBtn {{navType=='InBodyCommunity'?'on':''}}"  bindtap="moveNavTap">
      <cover-image style="width: 30px; height: 30px;" mode="aspectFill" src="{{communitySrc}}"></cover-image>
    </cover-view>
  </cover-view>
